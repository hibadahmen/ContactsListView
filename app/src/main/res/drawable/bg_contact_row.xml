<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Contact sélectionné -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/contacts_primary_light" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/contacts_primary" />
        </shape>
    </item>

    <!-- Contact non sélectionné -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/contacts_white" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/contacts_border" />
        </shape>
    </item>

</selector>